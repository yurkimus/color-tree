] AS block

MATCH (category:ColorCategory {level: 3, term: block.term})

MERGE (munsell:MunsellBlock {id: block.id})
SET
  munsell.hueBegin = block.hueBegin,
  munsell.hueEnd = block.hueEnd,
  munsell.hueBeginAmount = block.hueBeginAmount,
  munsell.hueEndAmount = block.hueEndAmount,
  munsell.hueIndex = block.hueIndex,
  munsell.valueBegin = block.valueBegin,
  munsell.valueEnd = block.valueEnd,
  munsell.chromaBegin = block.chromaBegin,
  munsell.chromaEnd = block.chromaEnd

MERGE (category)-[:HAS_BLOCK]->(munsell)
