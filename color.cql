  {level: 3, number: 264, term: 'LightGray', name: 'Light gray', abbr: 'l.Gy', parent: 'Gray'},
  {level: 3, number: 265, term: 'MediumGray', name: 'Medium gray', abbr: 'm.Gy', parent: 'Gray'},
  {level: 3, number: 266, term: 'DarkGray', name: 'Dark gray', abbr: 'd.Gy', parent: 'Gray'},
  {level: 3, number: 267, term: 'Black', name: 'Black', abbr: 'Bk', parent: 'Black'}
] AS color

MERGE (category:ColorCategory {level: color.level, term: color.term})
SET
  category.number = color.number,
  category.name = color.name,
  category.abbr = color.abbr

WITH collect({node: category, level: color.level, parent: color.parent}) AS categories

UNWIND categories AS color
WITH color.node AS category, color.level AS level, color.parent AS parent
WHERE parent IS NOT NULL

MATCH (broader:ColorCategory {level: level - 1, term: parent})
MERGE (category)-[:BROADER]->(broader)
